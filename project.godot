; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=4

[application]

config/name="MimesisLab"
run/main_scene="res://Game/Interfaces/Menu Principal/Menu Principal.tscn"
boot_splash/image="res://Game/Images/LOADING....png"
boot_splash/use_filter=false
boot_splash/bg_color=Color( 0, 0, 0, 1 )
config/icon="res://icono.png"

[autoload]

Global="*res://Game/Scripts/Global.gd"

[display]

window/size/width=384
window/size/height=216
window/size/fullscreen=true
window/stretch/mode="2d"

[gui]

common/drop_mouse_on_gui_input_disabled=true

